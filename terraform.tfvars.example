###############################################################################
# terraform.tfvars  — fill in your real values before running
###############################################################################

project_id           = "my-gcp-project-id"
region               = "us-central1"
environment          = "prod"

# ── Cloud Armor ───────────────────────────────────────────────────────────────
security_policy_name       = "cloud-armor-waf-policy"
enable_adaptive_protection = true

allowed_ip_ranges = [
  "203.0.113.0/24",   # Office network
  "198.51.100.5/32",  # VPN gateway
]

blocked_ip_ranges = [
  "192.0.2.0/24",   # Known bad subnet
]

blocked_countries = ["KP", "CU"]  # North Korea, Cuba (example)

rate_limit_count        = 200
rate_limit_interval_sec = 60

# ── Source / Repo ─────────────────────────────────────────────────────────────
# Option A: GitHub
github_owner     = "my-github-org"
github_repo_name = "my-app-repo"
create_source_repo = false

# Option B: Cloud Source Repositories (comment out github_* above)
# create_source_repo = true
# source_repo_name   = "cloud-armor-repo"

# ── Cloud Build ───────────────────────────────────────────────────────────────
trigger_name   = "deploy-cloud-armor"
trigger_branch = "main"

# ── Remote State ─────────────────────────────────────────────────────────────
tf_state_bucket = "my-gcp-project-id-tfstate"
